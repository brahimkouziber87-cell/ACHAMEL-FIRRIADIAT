# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SHARE_SECRET: Secret used to encrypt shared student/report links (AES-256-GCM).
# REQUIRED in production and must be at least 32 characters.
# If missing, a random per-process key is generated and all share links
# become unreadable after every restart.
SHARE_SECRET=""

# SHARE_STORE_PATH: Optional path for persisting encrypted share records.
# Defaults to ./data/shares.json (which is gitignored).
# On Cloud Run the filesystem is ephemeral: use a managed database for
# horizontal scaling instead of relying on this file.
SHARE_STORE_PATH=""

# ---------------------------------------------------------------------------
# Firebase Admin (API authentication)
# ---------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_JSON: full service-account JSON (single line).
# When set, every AI route and /api/share/create requires a valid Firebase
# ID token:  Authorization: Bearer <idToken>  (the web client sends it
# automatically once the teacher signs in with Google).
# Without it the API stays protected by rate limiting only, unless
# REQUIRE_AI_AUTH=true is set (then it returns 503 AUTH_NOT_CONFIGURED).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# REQUIRE_AI_AUTH: "true" refuses AI/sharing requests when Firebase Admin
# is not configured. Recommended for production.
REQUIRE_AI_AUTH="false"

# GOOGLE_CLOUD_PROJECT: used only when relying on Application Default
# Credentials instead of FIREBASE_SERVICE_ACCOUNT_JSON (e.g. Cloud Run).
GOOGLE_CLOUD_PROJECT=""
