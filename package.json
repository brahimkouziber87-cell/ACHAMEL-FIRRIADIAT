{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', {recursive: true, force: true}); try { fs.unlinkSync('server.js'); } catch (_) {}\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src",
    "size": "node scripts/check-bundle-size.mjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jszip": "^3.4.0",
    "@types/katex": "^0.16.8",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.546.0",
    "mathjs": "^15.2.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
